# Cloudflare Pages header rules
# https://developers.cloudflare.com/pages/configuration/headers/

# Novel covers, chapter illustrations, trailers and BGM.
# Filenames are stable (or timestamped), so content never changes under a given
# name — cache them for a year instead of revalidating every 4 hours.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Astro's own bundles are content-hashed.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800
