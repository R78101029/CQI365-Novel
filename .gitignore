# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.astro/

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Generated content (rebuilt during build)
site/src/content/novels/
site/src/content/intros/
site/src/data/novels-stats.json

# Output / temp
#
# EPUB 不進版本庫：單檔動輒 15–50 MB，每次重打包就再存一份完整副本，
# .git 已經因此膨脹到 900 MB 以上。EPUB 由 build-epub.mjs 隨時可重新產生，
# 要對外散布請上傳到 GitHub Releases，不要 commit 進來。
_output/*
_output/epub/

# Screenshots at repo root
blindorbit_page_*.png

# Excel files
*.xlsx

# Cloudflare
.wrangler/

# Tools
.playwright-mcp/
tools/

# Image backups (local only, large PNG originals before jpg compression)
**/raw_pngs/

# EPUB preview artifacts (regenerable, too large for git history)
*_Preview.epub

# Firecrawl scrape cache (local)
.firecrawl/

# Stray screenshots at repo root
/image.png

# 影片管線：所有產出（首幀、片段、音檔、成品）一律放 _output/video/{slug}/，
# 那整個目錄已經被上面的 _output/* 擋掉。
#
# projects/ 底下只留「決定性」的小檔：cast/ 角色參考圖、shots.json、劇本。
# 下面幾條是保險——逐一列目錄名遲早會漏（_smoke/ 就漏過一次，42MB 差點進版本庫）。
projects/*/_dev/media/**/*.mp4
projects/*/_dev/media/**/*.mov
projects/*/_dev/media/**/*.webm
projects/*/_dev/media/**/*.wav
projects/*/_dev/media/**/*.mp3
