{
  "_note": "模型註冊表。腳本從這裡讀 endpoint 與參數對應，不要在腳本裡 hardcode。",
  "_discovery": {
    "schema": "node scripts/video/fal-schema.mjs <endpoint_id>",
    "openapi": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id={endpoint}",
    "llms_txt": "https://fal.ai/models/{endpoint}/llms.txt",
    "catalog": "https://fal.ai/models",
    "rule": "verified 為 null 的項目，寫 adapter 前必須先跑 fal-schema.mjs 驗證參數名稱並回填。"
  },

  "image": {
    "default": "gemini-pro-image",
    "draft": "gemini-flash-image",
    "providers": {
      "gemini-pro-image": {
        "endpoint": "https://generativelanguage.googleapis.com/v1beta/interactions",
        "model": "gemini-3-pro-image",
        "auth": "GOOGLE_API_KEY (repo .env)",
        "max_input_images": 14,
        "max_characters": 5,
        "price_per_image_usd": { "1K": 0.134, "2K": 0.134, "4K": 0.24 },
        "verified": "2026-08-22"
      },
      "gemini-flash-image": {
        "endpoint": "https://generativelanguage.googleapis.com/v1beta/interactions",
        "model": "gemini-3.1-flash-image",
        "auth": "GOOGLE_API_KEY (repo .env)",
        "max_input_images": 14,
        "max_characters": 4,
        "price_per_image_usd": { "1K": 0.034, "2K": 0.05 },
        "verified": "2026-08-22"
      }
    }
  },

  "video": {
    "default": "seedance-2.5-i2v",
    "draft": "minimax-h3-i2v",
    "auth": "FAL_KEY",
    "client": "@fal-ai/client",
    "providers": {
      "seedance-2.5-i2v": {
        "endpoint": "bytedance/seedance-2.5/image-to-video",
        "engines": ["i2v", "first_last"],
        "params": {
          "prompt": "prompt",
          "first_frame": "image_url",
          "last_frame": "end_image_url",
          "duration": "duration",
          "resolution": "resolution"
        },
        "fixed": { "generate_audio": false, "bitrate_mode": "standard" },
        "duration_range": [4, 30],
        "duration_type": "string",
        "resolutions": ["480p", "720p", "1080p"],
        "aspect_ratio": "由輸入圖決定（此 endpoint 的 aspect_ratio 永遠是 auto）",
        "returns": ["video", "seed"],
        "price_note": "token 計價 (H×W×秒×24)/1024 × $0.0214/1K。16:9 含音訊約 $0.22/s@480p、$0.47/s@720p；關掉 generate_audio 較便宜",
        "verified": "2026-08-22"
      },
      "seedance-2.5-ref2v": {
        "endpoint": "bytedance/seedance-2.5/reference-to-video",
        "engines": ["ref2v"],
        "params": {
          "prompt": "prompt",
          "ref_images": "image_urls",
          "ref_videos": "video_urls",
          "ref_audios": "audio_urls",
          "duration": "duration",
          "resolution": "resolution",
          "aspect_ratio": "aspect_ratio"
        },
        "fixed": { "generate_audio": false },
        "aspect_ratios": ["auto", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"],
        "prompt_convention": "參考輸入是位置式的，prompt 內用 [Image1] [Video1] [Audio1] 指涉",
        "verified": "2026-08-22"
      },
      "minimax-h3-i2v": {
        "endpoint": null,
        "engines": ["i2v"],
        "price_note": "$0.08/s @768p — 跑草片用",
        "verified": null,
        "todo": "跑 fal-schema.mjs 確認 endpoint 與參數"
      },
      "vidu-q3-ref2v": {
        "endpoint": null,
        "engines": ["ref2v"],
        "price_note": "~$0.11–0.13/s，1–4 張參考圖，多角色一致性 CP 值高",
        "verified": null,
        "todo": "跑 fal-schema.mjs 確認 endpoint 與參數"
      }
    }
  }
}
