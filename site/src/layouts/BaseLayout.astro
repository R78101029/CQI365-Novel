---
import config from '../../../novels.config.json';

interface Props {
  title: string;
  description?: string;
  /** Path or absolute URL of the social preview image. Defaults to the site card. */
  image?: string;
  /** 'website' for index pages, 'book' for a novel page. */
  ogType?: string;
}

const {
  title,
  description = `${config.site.name}｜${config.site.tagline}｜${config.site.author}`,
  image = '/og-default.jpg',
  ogType = 'website',
} = Astro.props;

const site = Astro.site ?? new URL('https://novels.cqi365.net');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = /^https?:\/\//i.test(image) ? image : new URL(image, site).href;
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical.href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={config.site.name} />
  <meta property="og:locale" content="zh_TW" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.href} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="author" content={config.site.author} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {/*
    The CJK font stylesheet is huge (hundreds of @font-face rules) and pulls ~45 woff2
    subsets. Loaded as media="print" it no longer blocks first paint; onload promotes it
    to all. Text renders immediately in the fallback stack (Microsoft JhengHei / PingFang
    TC), then swaps. Noto Serif TC is deliberately not requested — no rule ever used it.
  */}
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all';this.onload=null;"
  />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </noscript>
  <title>{title}</title>

  {/* Inline init to apply theme + reader-size before paint (avoid FOUC) */}
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme');        // 'dark' | 'light' | null
        if (t === 'dark' || t === 'light') {
          document.documentElement.setAttribute('data-theme', t);
        }
        var s = localStorage.getItem('readerSize');   // 'small' | 'medium' | 'large' | null
        if (s === 'small' || s === 'medium' || s === 'large') {
          document.documentElement.setAttribute('data-reader-size', s);
        }
      } catch (_) { /* ignore */ }
    })();
  </script>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-MDFYKE7LYX"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-MDFYKE7LYX');
  </script>
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/" class="site-logo">
        <div class="site-logo-icon">N</div>
        <span class="site-title">Novels<span>365</span></span>
      </a>
      <nav class="site-nav">
        <a href="/">首頁</a>
        <a href="/music/">音樂</a>
        <a href="https://blog.cqi365.net" target="_blank">部落格</a>
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          aria-label="切換深淺色模式"
          title="切換深淺色模式"
        >
          <span class="icon-light" aria-hidden="true">🌙</span>
          <span class="icon-dark" aria-hidden="true">☀️</span>
        </button>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <p>&copy; 2026 {config.site.name}　·　作者 {config.site.author}（Hugo Lin）　·　版權所有</p>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var current = document.documentElement.getAttribute('data-theme');
        // Determine effective current mode (explicit or system)
        var effective = current;
        if (!effective) {
          effective = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark' : 'light';
        }
        var next = effective === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (_) {}
      });
    })();
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
