---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../../../novels.config.json';

// Show a few readable novels so a wrong URL still leads somewhere useful
const suggestions = config.novels
  .filter((n) => n.status !== 'draft')
  .slice(0, 4);
---

<BaseLayout title="找不到這一頁 - Novels365" description="這個網址不存在或已經移動。">
  <section class="section">
    <div class="container">
      <div class="notfound">
        <p class="notfound-code">404</p>
        <h1>這一頁不存在</h1>
        <p class="notfound-text">
          網址可能打錯了，或這篇內容已經移動位置。
        </p>

        <div class="notfound-actions">
          <a href="/" class="btn btn-primary">回到首頁</a>
        </div>

        <div class="notfound-suggestions">
          <p class="notfound-label">或者直接開始讀一本</p>
          <ul>
            {suggestions.map((n) => (
              <li><a href={`/novel/${n.slug}/`}>{n.title}</a><span>{n.genre}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    max-width: 34rem;
    margin: 0 auto;
    padding: 4rem 0 6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  .notfound-code {
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    margin: 0;
    color: var(--color-text-muted, #888);
    letter-spacing: 0.05em;
  }

  .notfound h1 {
    font-size: 1.75rem;
    margin: 0;
  }

  .notfound-text {
    margin: 0;
    color: var(--color-text-muted, #888);
  }

  .notfound-actions {
    margin: 0.5rem 0 2rem;
  }

  .notfound-suggestions {
    border-top: 1px solid var(--color-border, #ddd);
    padding-top: 1.5rem;
    text-align: left;
  }

  .notfound-label {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted, #888);
  }

  .notfound-suggestions ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .notfound-suggestions li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border, #eee);
  }

  .notfound-suggestions span {
    font-size: 0.8rem;
    color: var(--color-text-muted, #888);
    white-space: nowrap;
  }
</style>
