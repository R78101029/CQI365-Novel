---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChapterSidebar from '../../../components/ChapterSidebar.astro';
import { getCollection, render } from 'astro:content';
import config from '../../../../../novels.config.json';
import stats from '../../../data/novels-stats.json';

export async function getStaticPaths() {
  return config.novels.map(novel => ({
    params: { novelSlug: novel.slug },
    props: { novel },
  }));
}

const { novel } = Astro.props;
const novelStats = stats[novel.slug] || { chapters: 0, words: 0, wordsFormatted: '0' };

// Get all chapters for this novel, sorted
const allChapters = await getCollection('novels');
const regex = new RegExp(`^${novel.slug}\/`, 'i');
const chapters = allChapters
  .filter(c => c.id.toLowerCase().startsWith(`${novel.slug.toLowerCase()}/`))
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

// Render each chapter's Content component
const chapterData = await Promise.all(
  chapters.map(async (c) => {
    const slug = c.id.replace(regex, '').replace('.md', '');
    const { Content } = await render(c);
    return {
      slug,
      order: c.data.order || 0,
      title: c.data.title,
      cover: c.data.cover,
      coverUrl: c.data.cover_url,
      video: c.data.video,
      audio: c.data.audio,
      audioTitle: c.data.audio_title,
      Content,
    };
  })
);

function resolveAudioUrl(audio: string | undefined): string | null {
  if (!audio) return null;
  if (/^https?:\/\//i.test(audio) || audio.startsWith('/')) return audio;
  return `/assets/${novel.slug}/audio/${audio}`;
}

function resolveCoverUrl(c: { coverUrl?: string; cover?: string }): string | null {
  if (c.coverUrl) return c.coverUrl;
  if (c.cover) return `/assets/${novel.slug}/chapters/${c.cover}`;
  return null;
}

const audioManifest = chapterData
  .map((c) => {
    const url = resolveAudioUrl(c.audio);
    if (!url) return null;
    return {
      slug: c.slug,
      url,
      title: c.audioTitle || c.title,
      cover: resolveCoverUrl(c) || '',
    };
  })
  .filter((x): x is { slug: string; url: string; title: string; cover: string } => !!x);

const hasAudio = audioManifest.length > 0;

interface VideoInfo { kind: 'youtube' | 'native'; src: string; vertical: boolean }
function parseVideo(url?: string): VideoInfo | null {
  if (!url) return null;
  // YouTube Shorts
  let m = url.match(/youtube\.com\/shorts\/([A-Za-z0-9_-]+)/);
  if (m) return { kind: 'youtube', src: `https://www.youtube.com/embed/${m[1]}`, vertical: true };
  // YouTube watch
  m = url.match(/youtube\.com\/watch\?v=([A-Za-z0-9_-]+)/);
  if (m) return { kind: 'youtube', src: `https://www.youtube.com/embed/${m[1]}`, vertical: false };
  // youtu.be shortlink
  m = url.match(/youtu\.be\/([A-Za-z0-9_-]+)/);
  if (m) return { kind: 'youtube', src: `https://www.youtube.com/embed/${m[1]}`, vertical: false };
  // Already an embed URL
  if (url.includes('youtube.com/embed/')) {
    return { kind: 'youtube', src: url, vertical: url.includes('shorts') };
  }
  // Otherwise assume native video (mp4)
  return { kind: 'native', src: url, vertical: false };
}

const chapterList = chapterData.map(c => ({ slug: c.slug, title: c.title, order: c.order }));
const shortTitle = novel.title.split(' ')[0];

function getChapterCoverUrl(ch: { coverUrl?: string; cover?: string }): string | null {
  if (ch.coverUrl) return ch.coverUrl;
  if (ch.cover) return `/assets/${novel.slug}/chapters/${ch.cover}`;
  return null;
}
---

<BaseLayout title={`${novel.title} - ${novel.titleEn || '全書'}`} description={novel.description}>
  <div class="chapter-shell">
    <button
      type="button"
      class="sidebar-toggle"
      id="sidebar-toggle"
      aria-label="切換目錄"
      aria-expanded="false"
      aria-controls="chapter-sidebar"
    >
      <span class="hamburger" aria-hidden="true">☰</span>
      <span class="sidebar-toggle-label">目錄</span>
    </button>

    <div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>

    <ChapterSidebar
      novelSlug={novel.slug}
      novelTitle={shortTitle}
      novelTitleEn={novel.titleEn}
      parts={novel.parts}
      chapters={chapterList}
      currentSlug={chapterList[0]?.slug || ''}
      anchorMode={true}
    />

    <article class="book-reader">
      {/* Intro video at the very top */}
      {novel.videoUrl && (
        <figure class="book-trailer">
          <video controls preload="metadata" poster={novel.coverUrl}>
            <source src={novel.videoUrl} type="video/mp4" />
            您的瀏覽器不支援影片播放。
          </video>
        </figure>
      )}

      {/* Book header */}
      <header class="book-header">
        {novel.coverUrl && !novel.videoUrl && (
          <img src={novel.coverUrl} alt={novel.title} class="book-cover" />
        )}
        <h1>{novel.title}</h1>
        {novel.titleEn && <p class="title-en">{novel.titleEn}</p>}
        <p class="meta">
          {config.site.author} · {novel.statusText || novel.status} · {chapters.length} 章 · {novelStats.wordsFormatted}
        </p>
        <p class="description">{novel.description}</p>
      </header>

      {/* Reader toolbar (font size) */}
      <div class="chapter-toolbar" role="region" aria-label="閱讀工具">
        <span class="chapter-progress" id="chapter-progress" aria-live="polite"></span>
        <div class="font-size-controls" role="group" aria-label="字級調整">
          <span class="label">字級</span>
          <button type="button" class="font-size-btn" data-size="small"  aria-label="較小字級"><span class="small">A</span></button>
          <button type="button" class="font-size-btn" data-size="medium" aria-label="標準字級"><span class="medium">A</span></button>
          <button type="button" class="font-size-btn" data-size="large"  aria-label="較大字級"><span class="large">A</span></button>
        </div>
      </div>

      {/* All chapters rendered continuously */}
      {chapterData.map((ch, i) => {
        const video = parseVideo(ch.video);
        return (
          <section class="chapter-section" id={ch.slug} data-chapter-index={i + 1}>
            <header class="chapter-header">
              <span class="chapter-number">第 {i + 1} / {chapters.length} 章</span>
              <h2>{ch.title}</h2>
              {getChapterCoverUrl(ch) && (
                <figure class="chapter-cover">
                  <img src={getChapterCoverUrl(ch)} alt={ch.title} loading="lazy" />
                </figure>
              )}
            </header>

            {video && (
              <figure class={`chapter-video ${video.vertical ? 'vertical' : 'horizontal'}`}>
                {video.kind === 'youtube' ? (
                  <iframe
                    class="chapter-video-frame"
                    src={video.src}
                    loading="lazy"
                    title={`${ch.title} 動畫`}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  />
                ) : (
                  <video class="chapter-video-frame" controls preload="metadata">
                    <source src={video.src} type="video/mp4" />
                  </video>
                )}
              </figure>
            )}

            <div class="chapter-content">
              <ch.Content />
            </div>
          </section>
        );
      })}

      {/* End-of-book marker */}
      <footer class="book-end">
        <p>—— 全書完 ——</p>
        <p><a href="/">回到首頁</a></p>
      </footer>
    </article>
  </div>

  {hasAudio && (
    <div
      class="bgm-dock"
      id="bgm-player"
      data-manifest={JSON.stringify(audioManifest)}
      hidden
    >
      <div class="bgm-dock-inner">
        {audioManifest[0]?.cover
          ? <img class="bgm-cover" id="bgm-cover" src={audioManifest[0].cover} alt="" />
          : <img class="bgm-cover" id="bgm-cover" alt="" style="display:none" />}
        <div class="bgm-info">
          <span class="bgm-label">配樂</span>
          <span class="bgm-track" id="bgm-track">{audioManifest[0]?.title || '—'}</span>
        </div>
        <button type="button" class="bgm-toggle" id="bgm-toggle" aria-label="播放 / 暫停" aria-pressed="false">
          <span class="bgm-icon bgm-icon-play" aria-hidden="true">▶</span>
          <span class="bgm-icon bgm-icon-pause" aria-hidden="true">❚❚</span>
        </button>
        <button type="button" class="bgm-mute" id="bgm-mute" aria-label="靜音" aria-pressed="false">
          <span class="bgm-icon bgm-icon-vol" aria-hidden="true">🔊</span>
          <span class="bgm-icon bgm-icon-mute" aria-hidden="true">🔇</span>
        </button>
        <button type="button" class="bgm-close" id="bgm-close" aria-label="關閉音樂列">✕</button>
      </div>
      <audio id="bgm-audio" preload="none" loop></audio>
    </div>
  )}

  <script is:inline>
    (function () {
      // ===== Font size controls =====
      var btns = document.querySelectorAll('.font-size-btn');
      if (btns.length) {
        function applySize(size) {
          document.documentElement.setAttribute('data-reader-size', size);
          btns.forEach(function (b) {
            b.classList.toggle('active', b.getAttribute('data-size') === size);
          });
        }
        var initial = null;
        try { initial = localStorage.getItem('readerSize'); } catch (_) {}
        if (initial !== 'small' && initial !== 'medium' && initial !== 'large') {
          initial = document.documentElement.getAttribute('data-reader-size') || 'medium';
        }
        applySize(initial);
        btns.forEach(function (b) {
          b.addEventListener('click', function () {
            var size = b.getAttribute('data-size');
            applySize(size);
            try { localStorage.setItem('readerSize', size); } catch (_) {}
          });
        });
      }

      // ===== Sidebar toggle (mobile) =====
      var shell = document.querySelector('.chapter-shell');
      var toggle = document.getElementById('sidebar-toggle');
      var backdrop = document.getElementById('sidebar-backdrop');
      function closeSidebar() {
        shell && shell.classList.remove('sidebar-open');
        toggle && toggle.setAttribute('aria-expanded', 'false');
      }
      function openSidebar() {
        shell && shell.classList.add('sidebar-open');
        toggle && toggle.setAttribute('aria-expanded', 'true');
      }
      if (toggle && shell) {
        toggle.addEventListener('click', function () {
          if (shell.classList.contains('sidebar-open')) closeSidebar(); else openSidebar();
        });
      }
      if (backdrop) {
        backdrop.addEventListener('click', closeSidebar);
      }
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeSidebar();
      });

      // Close sidebar after clicking a chapter anchor on mobile
      document.querySelectorAll('.sidebar-chapter-list a').forEach(function (a) {
        a.addEventListener('click', function () {
          if (window.innerWidth < 1024) closeSidebar();
        });
      });

      // ===== Intersection Observer: sync sidebar active + URL hash as user scrolls =====
      var sections = document.querySelectorAll('.chapter-section');
      var totalChapters = sections.length;
      var progressEl = document.getElementById('chapter-progress');
      var sidebarItemsBySlug = {};
      document.querySelectorAll('.sidebar-chapter-list li').forEach(function (li) {
        var s = li.getAttribute('data-slug');
        if (s) sidebarItemsBySlug[s] = li;
      });

      function setActive(slug, index) {
        Object.keys(sidebarItemsBySlug).forEach(function (s) {
          sidebarItemsBySlug[s].classList.toggle('is-current', s === slug);
        });
        // Notify BGM player (if present) that active chapter changed
        if (typeof window.__bgmOnChapterChange === 'function') {
          window.__bgmOnChapterChange(slug);
        }
        // Update URL hash without jumping
        try { history.replaceState(null, '', '#' + slug); } catch (_) {}
        // Update progress text
        if (progressEl && totalChapters > 1) {
          progressEl.innerHTML = '第 <strong>' + index + '</strong> / ' + totalChapters + ' 章';
        }
        // Auto-scroll sidebar to keep current item visible
        var li = sidebarItemsBySlug[slug];
        if (li) {
          var rect = li.getBoundingClientRect();
          var sidebar = document.getElementById('chapter-sidebar');
          if (sidebar) {
            var sbRect = sidebar.getBoundingClientRect();
            if (rect.top < sbRect.top + 40 || rect.bottom > sbRect.bottom - 40) {
              try { li.scrollIntoView({ block: 'center', behavior: 'instant' }); }
              catch (_) { li.scrollIntoView({ block: 'center' }); }
            }
          }
        }
      }

      if ('IntersectionObserver' in window && sections.length) {
        var activeSlug = null;
        var obs = new IntersectionObserver(function (entries) {
          // Prefer the section whose top is closest to the activation zone (top 20%)
          var candidates = [];
          entries.forEach(function (e) {
            if (e.isIntersecting) candidates.push(e);
          });
          // All currently-visible sections — pick the one with smallest top distance from 100px
          var visible = [];
          sections.forEach(function (s) {
            var r = s.getBoundingClientRect();
            if (r.bottom > 80 && r.top < window.innerHeight * 0.5) {
              visible.push({ el: s, top: r.top });
            }
          });
          if (!visible.length) return;
          // Pick the one with the smallest positive (or least negative) top
          visible.sort(function (a, b) {
            var ax = a.top < 80 ? 80 - a.top : a.top - 80;
            var bx = b.top < 80 ? 80 - b.top : b.top - 80;
            return ax - bx;
          });
          var best = visible[0].el;
          if (best && best.id !== activeSlug) {
            activeSlug = best.id;
            var idx = parseInt(best.getAttribute('data-chapter-index') || '0', 10);
            setActive(activeSlug, idx);
          }
        }, {
          rootMargin: '-80px 0px -50% 0px',
          threshold: [0, 0.01, 0.25, 0.5],
        });
        sections.forEach(function (s) { obs.observe(s); });
      }

      // ===== Initial setup: jump to #hash if present, else mark first chapter =====
      var firstSection = sections[0];
      if (location.hash && location.hash.length > 1) {
        var target = document.getElementById(location.hash.slice(1));
        if (target) {
          setTimeout(function () { target.scrollIntoView({ block: 'start' }); }, 0);
          var idx = parseInt(target.getAttribute('data-chapter-index') || '1', 10);
          setActive(target.id, idx);
        } else if (firstSection) {
          setActive(firstSection.id, 1);
        }
      } else if (firstSection) {
        setActive(firstSection.id, 1);
      }
    })();
  </script>

  {hasAudio && (
  <script is:inline>
    (function () {
      var root = document.getElementById('bgm-player');
      if (!root) return;
      var audio = document.getElementById('bgm-audio');
      var toggle = document.getElementById('bgm-toggle');
      var muteBtn = document.getElementById('bgm-mute');
      var closeBtn = document.getElementById('bgm-close');
      var trackEl = document.getElementById('bgm-track');
      var coverEl = document.getElementById('bgm-cover');

      var manifest;
      try { manifest = JSON.parse(root.getAttribute('data-manifest') || '[]'); }
      catch (_) { manifest = []; }
      if (!manifest.length) return;

      var byslug = {};
      manifest.forEach(function (m) { byslug[m.slug] = m; });

      // Restore user prefs
      var muted = false;
      var userStarted = false;  // true after user has clicked play once
      var dismissed = false;
      try {
        muted = localStorage.getItem('bgmMuted') === '1';
        dismissed = localStorage.getItem('bgmDismissed') === '1';
      } catch (_) {}
      audio.muted = muted;
      audio.volume = 0.6;
      updateMuteUI();

      if (!dismissed) {
        root.hidden = false;
        document.body.classList.add('has-bgm-dock');
      }

      var currentUrl = null;
      var fadeTimer = null;

      function updateToggleUI(playing) {
        toggle.setAttribute('aria-pressed', playing ? 'true' : 'false');
        root.classList.toggle('is-playing', playing);
      }
      function updateMuteUI() {
        muteBtn.setAttribute('aria-pressed', muted ? 'true' : 'false');
        root.classList.toggle('is-muted', muted);
      }

      function fadeTo(target, ms, onDone) {
        if (fadeTimer) { clearInterval(fadeTimer); fadeTimer = null; }
        var start = audio.volume;
        var steps = Math.max(1, Math.floor(ms / 40));
        var i = 0;
        fadeTimer = setInterval(function () {
          i++;
          audio.volume = Math.max(0, Math.min(1, start + (target - start) * (i / steps)));
          if (i >= steps) {
            clearInterval(fadeTimer); fadeTimer = null;
            if (onDone) onDone();
          }
        }, 40);
      }

      function updateCover(cover) {
        if (!coverEl) return;
        if (cover) { coverEl.src = cover; coverEl.style.display = ''; }
        else { coverEl.removeAttribute('src'); coverEl.style.display = 'none'; }
      }

      function playUrl(url, title, cover) {
        if (url === currentUrl && !audio.paused) return;
        trackEl.textContent = title || '';
        updateCover(cover);
        if (audio.paused || !currentUrl) {
          audio.src = url;
          currentUrl = url;
          audio.volume = 0;
          var p = audio.play();
          if (p && p.catch) p.catch(function () { /* autoplay blocked */ });
          fadeTo(muted ? 0 : 0.6, 600);
          updateToggleUI(true);
        } else {
          // Crossfade: fade out → swap src → fade in
          fadeTo(0, 300, function () {
            audio.src = url;
            currentUrl = url;
            var p = audio.play();
            if (p && p.catch) p.catch(function () {});
            fadeTo(muted ? 0 : 0.6, 500);
          });
        }
      }

      window.__bgmOnChapterChange = function (slug) {
        var entry = byslug[slug];
        if (!entry) return;  // chapter has no audio → keep playing previous
        if (!userStarted) {
          // Not yet authorized — preview track info without playing
          trackEl.textContent = entry.title;
          updateCover(entry.cover);
          currentUrl = null;  // force src swap on first play
          root.setAttribute('data-pending-url', entry.url);
          root.setAttribute('data-pending-cover', entry.cover || '');
          return;
        }
        playUrl(entry.url, entry.title, entry.cover);
      };

      toggle.addEventListener('click', function () {
        if (!userStarted) {
          userStarted = true;
          var pending = root.getAttribute('data-pending-url');
          var currentSlug = (location.hash || '').slice(1);
          var entry = byslug[currentSlug] || manifest[0];
          var url = pending || entry.url;
          playUrl(url, entry.title, entry.cover);
          return;
        }
        if (audio.paused) {
          var p = audio.play();
          if (p && p.catch) p.catch(function () {});
          fadeTo(muted ? 0 : 0.6, 400);
          updateToggleUI(true);
        } else {
          fadeTo(0, 300, function () { audio.pause(); });
          updateToggleUI(false);
        }
      });

      muteBtn.addEventListener('click', function () {
        muted = !muted;
        audio.muted = muted;
        try { localStorage.setItem('bgmMuted', muted ? '1' : '0'); } catch (_) {}
        updateMuteUI();
      });

      closeBtn.addEventListener('click', function () {
        fadeTo(0, 300, function () { audio.pause(); });
        root.hidden = true;
        document.body.classList.remove('has-bgm-dock');
        try { localStorage.setItem('bgmDismissed', '1'); } catch (_) {}
      });

      audio.addEventListener('play',  function () { updateToggleUI(true); });
      audio.addEventListener('pause', function () { updateToggleUI(false); });

      // Initialize track label + cover to the first chapter that has audio
      var initialSlug = (location.hash || '').slice(1);
      var initialEntry = byslug[initialSlug] || manifest[0];
      if (initialEntry) {
        trackEl.textContent = initialEntry.title;
        updateCover(initialEntry.cover);
      }
    })();
  </script>
  )}
</BaseLayout>
