---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../../../novels.config.json';
import stats from '../data/novels-stats.json';

// Novel data - dynamically loaded from config and stats
const novels = config.novels.map(novel => {
  const novelStats = stats[novel.slug] || { chapters: 0, words: 0, wordsFormatted: '0' };
  return {
    ...novel,
    chapters: novelStats.chapters,
    words: novelStats.wordsFormatted,
    rawWords: novelStats.words || 0,
    readUrl: `/novel/${novel.slug}/`,
  };
});

// Aggregate stats for hero
const totalNovels = novels.length;
const totalChapters = novels.reduce((sum, n) => sum + n.chapters, 0);
const totalRawWords = novels.reduce((sum, n) => sum + n.rawWords, 0);
const totalWordsFormatted = totalRawWords >= 10000
  ? `${(totalRawWords / 10000).toFixed(1).replace(/\.0$/, '')} 萬字`
  : `${totalRawWords.toLocaleString()} 字`;

// Structured data: the site itself, plus the shelf as an ordered list of books.
const siteUrl = Astro.site ?? new URL('https://novels.cqi365.net');
const author = { '@type': 'Person', name: config.site.author, alternateName: 'Hugo Lin' };

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.href}#website`,
      url: siteUrl.href,
      name: config.site.name,
      description: config.site.subtitle,
      inLanguage: 'zh-TW',
      author,
    },
    {
      '@type': 'ItemList',
      name: `${config.site.author}作品列表`,
      numberOfItems: novels.length,
      itemListElement: novels.map((n, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Book',
          name: n.title,
          alternateName: n.titleEn || undefined,
          url: new URL(n.readUrl, siteUrl).href,
          image: n.coverUrl ? new URL(n.coverUrl, siteUrl).href : undefined,
          genre: n.genre,
          inLanguage: 'zh-TW',
          author,
          isbn: stats[n.slug]?.isbn || undefined,
        },
      })),
    },
  ],
};
---

<BaseLayout title="Novels365 - 原創小說平台">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

  <!-- Hero Section (compact) -->
  <section class="hero">
    <div class="hero-container">
      <div class="hero-content">
        <span class="hero-badge">原創小說平台</span>
        <h1>{config.site.name}</h1>
        <p class="subtitle">{config.site.subtitle}</p>
        <p class="hero-stats">
          <strong>{totalNovels}</strong> 部作品
          <span class="sep">·</span>
          <strong>{totalChapters}</strong> 章
          <span class="sep">·</span>
          <strong>{totalWordsFormatted}</strong>
        </p>
        <div class="hero-buttons">
          <a href="#novels" class="btn btn-primary">
            探索作品
            <span>↓</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Novels Section -->
  <section id="novels" class="section">
    <div class="container-wide">
      <div class="section-header">
        <h2>作品列表</h2>
        <p>精選原創中文小說</p>
      </div>

      <!-- Novel Grid -->
      <div class="novel-grid">
        {novels.map((novel) => (
          <article class="novel-card">
            {novel.coverUrl && (
              <a class="novel-card-cover" href={novel.readUrl} aria-label={novel.title}>
                <img src={novel.coverUrl} alt={novel.title} loading="lazy" />
              </a>
            )}
            <div class="novel-card-content">
              <div class="novel-card-header">
                <span class="novel-card-genre">{novel.genre}</span>
                <h3><a href={novel.readUrl}>{novel.title}</a></h3>
                {novel.titleEn && <p class="novel-card-title-en">{novel.titleEn}</p>}
                <div class="novel-card-meta">
                  <span class={`status-badge ${novel.status}`}>
                    <span class="status-dot"></span>
                    {novel.statusText}
                  </span>
                  <span>{novel.chapters} 章</span>
                  <span>{novel.words} 字</span>
                </div>
              </div>
              <div class="novel-card-body">
                <p class="novel-card-description">{novel.description}</p>
                <div class="novel-card-tags">
                  {novel.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
              <div class="novel-card-footer">
                {novel.status === 'draft' ? (
                  <span class="novel-card-link draft-link">
                    <span>撰寫中，敬請期待</span>
                  </span>
                ) : (
                  <a href={novel.readUrl} class="novel-card-link">
                    <span>開始閱讀</span>
                    <span>→</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
