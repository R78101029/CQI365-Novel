---
import BaseLayout from './BaseLayout.astro';
import ChapterSidebar from '../components/ChapterSidebar.astro';

interface ChapterItem {
  slug: string;
  title: string;
  order: number;
}
interface PartDef {
  title?: string;
  book?: string;
  range: [number, number];
}
interface Props {
  title: string;
  novelTitle: string;
  novelTitleEn?: string;
  novelSlug: string;
  currentSlug: string;
  chapterNumber?: string;
  prevChapter?: { slug: string; title: string } | null;
  nextChapter?: { slug: string; title: string } | null;
  coverUrl?: string;
  cover?: string;
  currentIndex?: number;
  totalChapters?: number;
  chapters: ChapterItem[];
  parts?: PartDef[];
}

const {
  title,
  novelTitle,
  novelTitleEn,
  novelSlug,
  currentSlug,
  chapterNumber,
  prevChapter,
  nextChapter,
  coverUrl,
  cover,
  currentIndex,
  totalChapters,
  chapters,
  parts,
} = Astro.props;

// Extract short novel title (e.g., "盲軌：2028" from "盲軌：2028 (Blind Orbit)")
const shortNovelTitle = novelTitle.split(' ')[0];

// Resolve cover image URL
let coverImageUrl: string | null = null;
if (coverUrl) {
  coverImageUrl = coverUrl;
} else if (cover) {
  coverImageUrl = `/assets/${novelSlug}/chapters/${cover}`;
}

const hasProgress = typeof currentIndex === 'number' && typeof totalChapters === 'number' && totalChapters > 1;
---

<BaseLayout title={`【${shortNovelTitle}】${title}`}>
  <div class="chapter-shell">
    <button
      type="button"
      class="sidebar-toggle"
      id="sidebar-toggle"
      aria-label="切換目錄"
      aria-expanded="false"
      aria-controls="chapter-sidebar"
    >
      <span class="hamburger" aria-hidden="true">☰</span>
      <span class="sidebar-toggle-label">目錄</span>
    </button>

    <div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>

    <ChapterSidebar
      novelSlug={novelSlug}
      novelTitle={shortNovelTitle}
      novelTitleEn={novelTitleEn}
      parts={parts}
      chapters={chapters}
      currentSlug={currentSlug}
    />

    <article class="chapter-article">
      <header class="chapter-header">
        <p class="meta">
          <a href={`/novel/${novelSlug}`}>{novelTitle}</a>
        </p>
        {chapterNumber && <span class="chapter-number">{chapterNumber}</span>}
        <h1>【{shortNovelTitle}】{title}</h1>
        {coverImageUrl && (
          <figure class="chapter-cover">
            <img src={coverImageUrl} alt={title} loading="lazy" />
          </figure>
        )}
      </header>

      <div class="chapter-toolbar" role="region" aria-label="閱讀工具">
        {hasProgress ? (
          <span class="chapter-progress" aria-label="章節進度">
            第 <strong>{currentIndex}</strong> / {totalChapters} 章
          </span>
        ) : <span class="chapter-progress"></span>}

        <div class="font-size-controls" role="group" aria-label="字級調整">
          <span class="label">字級</span>
          <button type="button" class="font-size-btn" data-size="small"  aria-label="較小字級"><span class="small">A</span></button>
          <button type="button" class="font-size-btn" data-size="medium" aria-label="標準字級"><span class="medium">A</span></button>
          <button type="button" class="font-size-btn" data-size="large"  aria-label="較大字級"><span class="large">A</span></button>
        </div>
      </div>

      <div class="chapter-content">
        <slot />
      </div>

      <nav class="chapter-nav">
        {prevChapter ? (
          <a href={`/novel/${novelSlug}/${prevChapter.slug}`}>
            <span>←</span>
            <span>{prevChapter.title}</span>
          </a>
        ) : <span></span>}

        {nextChapter ? (
          <a href={`/novel/${novelSlug}/${nextChapter.slug}`}>
            <span>{nextChapter.title}</span>
            <span>→</span>
          </a>
        ) : <span></span>}
      </nav>
    </article>
  </div>

  <script is:inline>
    (function () {
      // ===== Font size controls =====
      var btns = document.querySelectorAll('.font-size-btn');
      if (btns.length) {
        function applySize(size) {
          document.documentElement.setAttribute('data-reader-size', size);
          btns.forEach(function (b) {
            b.classList.toggle('active', b.getAttribute('data-size') === size);
          });
        }
        var initial = null;
        try { initial = localStorage.getItem('readerSize'); } catch (_) {}
        if (initial !== 'small' && initial !== 'medium' && initial !== 'large') {
          initial = document.documentElement.getAttribute('data-reader-size') || 'medium';
        }
        applySize(initial);
        btns.forEach(function (b) {
          b.addEventListener('click', function () {
            var size = b.getAttribute('data-size');
            applySize(size);
            try { localStorage.setItem('readerSize', size); } catch (_) {}
          });
        });
      }

      // ===== Sidebar toggle (mobile) =====
      var shell = document.querySelector('.chapter-shell');
      var toggle = document.getElementById('sidebar-toggle');
      var backdrop = document.getElementById('sidebar-backdrop');
      function closeSidebar() {
        shell && shell.classList.remove('sidebar-open');
        toggle && toggle.setAttribute('aria-expanded', 'false');
      }
      function openSidebar() {
        shell && shell.classList.add('sidebar-open');
        toggle && toggle.setAttribute('aria-expanded', 'true');
      }
      if (toggle && shell) {
        toggle.addEventListener('click', function () {
          if (shell.classList.contains('sidebar-open')) closeSidebar(); else openSidebar();
        });
      }
      if (backdrop) {
        backdrop.addEventListener('click', closeSidebar);
      }
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeSidebar();
      });

      // ===== Scroll active sidebar item into view =====
      var active = document.querySelector('.sidebar-chapter-list li.is-current');
      if (active && active.scrollIntoView) {
        try { active.scrollIntoView({ block: 'center', behavior: 'instant' }); } catch (_) {
          active.scrollIntoView({ block: 'center' });
        }
      }
    })();
  </script>
</BaseLayout>
