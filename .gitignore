# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.astro/

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Generated content (rebuilt during build)
site/src/content/novels/
site/src/content/intros/
site/src/data/novels-stats.json

# Output / temp
#
# EPUB 不進版本庫：單檔動輒 15–50 MB，每次重打包就再存一份完整副本，
# .git 已經因此膨脹到 900 MB 以上。EPUB 由 build-epub.mjs 隨時可重新產生，
# 要對外散布請上傳到 GitHub Releases，不要 commit 進來。
_output/*
_output/epub/

# Screenshots at repo root
blindorbit_page_*.png

# Excel files
*.xlsx

# Cloudflare
.wrangler/

# Tools
.playwright-mcp/
tools/

# Image backups (local only, large PNG originals before jpg compression)
**/raw_pngs/

# EPUB preview artifacts (regenerable, too large for git history)
*_Preview.epub

# Firecrawl scrape cache (local)
.firecrawl/

# Stray screenshots at repo root
/image.png

# 影片管線產物：可由 shots.json + frames/ 重新產生，單檔幾十 MB，不進版本庫。
# 追蹤的是「決定性素材」——cast/ 參考圖、frames/ 定稿首幀、shots.json；
# clips/ out/ audio/ 是算出來的東西。
projects/*/_dev/media/*/clips/
projects/*/_dev/media/*/out/
projects/*/_dev/media/*/audio/
projects/*/_dev/media/*/frames/_drafts/
